<Window x:Class="OwlLuna.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OwlLuna · Notizbücher" Width="1340" Height="900" MinWidth="940" MinHeight="650" Background="#EFF0E9" FontFamily="Segoe UI" Foreground="#273B36" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="KeyPressed">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FCFBF6" BorderBrush="#D8DED6" BorderThickness="0,0,0,1" Padding="18,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock Text="◕" FontSize="34" Margin="0,0,10,0"/><StackPanel><TextBlock Text="OwlLuna" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Deine Gedanken. Dein Papier." FontSize="11" Foreground="#728077"/></StackPanel></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="＋ Heft" Click="NewBook"/><Button Content="Importieren" Click="ImportFile"/><Button Content="Exportieren" Click="ExportMenu"/><Button Content="☁ Cloud &amp; Backup" Click="CloudSettings"/><Button Content="◐" Click="Appearance" ToolTip="Hell / Dunkel"/></StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#FCFBF6" Padding="14,7"><DockPanel><TextBlock x:Name="StateText" Text="Lokal bereit"/><TextBlock DockPanel.Dock="Right" x:Name="PageInfo" HorizontalAlignment="Right"/></DockPanel></Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#E6EBE1" Padding="12" BorderBrush="#D8DED6" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Hefte, Text und Tags durchsuchen"/><ComboBox x:Name="Scope" SelectionChanged="ScopeChanged" SelectedIndex="0"><ComboBoxItem Content="Alle Hefte"/><ComboBoxItem Content="Favoriten"/><ComboBoxItem Content="Papierkorb"/></ComboBox><TextBlock Text="BIBLIOTHEK" FontSize="11" FontWeight="SemiBold" Margin="8,18,0,10" Foreground="#67786C"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom"><Button Content="☆ Favorit" Click="Favorite"/><Button Content="Ordner / Tags / Titel" Click="BookProperties"/><Button Content="Papierkorb / Wiederherstellen" Click="TrashBook"/></StackPanel>
          <ListBox x:Name="BooksList" SelectionChanged="BookSelected" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" CornerRadius="6" Background="#F7F8F1"><StackPanel><Border Height="56" Width="42" Background="{Binding CoverColor}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,7"><TextBlock Text="☾" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#728077"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="12,8" VerticalAlignment="Center"><Button Content="Stift" Tag="pen" Click="ToolClick"/><Button Content="Füller" Tag="fountain" Click="ToolClick"/><Button Content="Bleistift" Tag="pencil" Click="ToolClick"/><Button Content="Marker" Tag="marker" Click="ToolClick"/><Button Content="Radierer" Tag="eraser" Click="ToolClick"/><Button Content="Lasso" Tag="select" Click="ToolClick"/><Button Content="Hand" Tag="hand" Click="ToolClick"/><Button Content="Text" Click="AddText"/><Button Content="Bild" Click="AddImage"/><Button Content="Form" Click="ShapeMenu"/><Button Content="↶" Click="Undo" ToolTip="Strg+Z"/><Button Content="↷" Click="Redo" ToolTip="Strg+Y"/><ComboBox x:Name="InkColor" Width="105" SelectionChanged="PenChanged" SelectedIndex="0"><ComboBoxItem Content="Tinte" Tag="#243B53"/><ComboBoxItem Content="Blau" Tag="#2857A4"/><ComboBoxItem Content="Rot" Tag="#B84040"/><ComboBoxItem Content="Grün" Tag="#397650"/><ComboBoxItem Content="Violett" Tag="#7C519D"/><ComboBoxItem Content="Gelb" Tag="#F3D54C"/></ComboBox><Slider x:Name="PenWidth" Width="90" Minimum="0.5" Maximum="18" Value="2.5" ValueChanged="PenChanged" VerticalAlignment="Center" ToolTip="Strichbreite"/><CheckBox x:Name="PencilOnly" Content="Nur Stift" IsChecked="True" VerticalAlignment="Center" Margin="8"/><Button Content="Entfernen" Click="DeleteSelection"/><Button Content="Mehr …" Click="MoreMenu"/></WrapPanel>
        <DockPanel Grid.Row="1" Margin="16,0,16,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="‹" Click="PreviousPage"/><TextBlock x:Name="PageNumber" VerticalAlignment="Center" Margin="8"/><Button Content="›" Click="NextPage"/><Button Content="＋ Seite" Click="AddPage"/><Button Content="⋯ Seite" Click="PageMenu"/><ComboBox x:Name="Paper" Width="115" SelectionChanged="PaperChanged" SelectedIndex="0"><ComboBoxItem Content="Kariert" Tag="grid"/><ComboBoxItem Content="Liniert" Tag="ruled"/><ComboBoxItem Content="Punkte" Tag="dotted"/><ComboBoxItem Content="Blanko" Tag="blank"/><ComboBoxItem Content="Cornell" Tag="cornell"/><ComboBoxItem Content="Noten" Tag="music"/></ComboBox></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Click="ZoomOut"/><Button Content="Anpassen" Click="FitPage"/><Button Content="＋" Click="ZoomIn"/></StackPanel></DockPanel>
        <ScrollViewer x:Name="PageScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" Background="#DDE3DC" Padding="30">
          <Border x:Name="PageBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White" BorderBrush="#C7CEC5" BorderThickness="1"><Grid x:Name="PageGrid" Width="595" Height="842"><Canvas x:Name="PaperCanvas" IsHitTestVisible="False"/><InkCanvas x:Name="Ink" Background="Transparent" Width="595" Height="842" StrokeCollected="StrokeCollected" StrokeErased="StrokeErased" SelectionMoved="SelectionChanged" SelectionResized="SelectionChanged" PreviewTouchDown="CanvasTouchDown"/></Grid></Border>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
